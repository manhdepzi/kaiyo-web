APP_NAME=Kaiyo
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://kaiyo.test

ANALYTICS_CONSENT_POLICY_REVISION=analytics-consent-v1
ANALYTICS_CONSENT_TTL_DAYS=180
ANALYTICS_CONSENT_COOKIE=kaiyo_analytics_consent
ANALYTICS_MAX_ATTRIBUTION_TOUCHES=20
ANALYTICS_DESTINATION_CODE=disabled
ANALYTICS_CONFIGURATION_REVISION=disabled-v1

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaiyo
DB_USERNAME=kaiyo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_MAX_BYTES=10485760
MEDIA_TEMPORARY_URL_MINUTES=10
QUEUE_CONNECTION=redis
OUTBOX_CLAIM_LEASE_SECONDS=300
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETENTION_CATALOG_DAYS=
OUTBOX_RETENTION_ORDER_PLACED_DAYS=
OUTBOX_RETENTION_ORDER_STATE_DAYS=
OUTBOX_RETENTION_INVENTORY_DAYS=
OUTBOX_RETENTION_PAYMENT_DAYS=
OUTBOX_RETENTION_QUOTATION_DAYS=
OUTBOX_RETENTION_SHIPPING_DAYS=

PAYMENT_CONFIGURATION_REVISION=payment-v1
PAYMENT_ONLINE_GATEWAY_ENABLED=false
PAYMENT_ONLINE_GATEWAY_PROVIDER=
SHIPPING_CONFIGURATION_REVISION=shipping-v1
QUOTATION_VALIDITY_REVISION=qvalid-v1
QUOTATION_DEFAULT_VALIDITY_DAYS=30
QUOTATION_MAXIMUM_VALIDITY_DAYS=30
QUOTATION_AUTHORITY_REVISION=d003-v1
QUOTATION_GUEST_ATTEMPTS_PER_MINUTE=5
CRM_PUBLIC_CONTACT_ATTEMPTS_PER_HOUR=5

CACHE_STORE=redis
CACHE_PREFIX=kaiyo_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Disaster recovery bindings/evidence are operationally owned. Do not place provider credentials here.
DR_BACKUP_BINDING_CONFIGURED=false
DR_MYSQL_PITR_CONFIGURED=false
DR_OBJECT_RECOVERY_CONFIGURED=false
DR_CONFIG_METADATA_BACKUP_CONFIGURED=false
DR_RESTORE_EVIDENCE_AT=
DR_ACHIEVED_RPO_SECONDS=
DR_ACHIEVED_RTO_SECONDS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TRUSTED_PROXIES=
HEALTH_DB_CHECK=false
HEALTH_CACHE_CHECK=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
